{
  "name": "restart-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React + TypeScript SPA for Restart — a step-by-step navigator through the Russian personal bankruptcy procedure. UI shell only; all legal/eligibility rules are the backend's responsibility.",
  "scripts": {
    "dev": "vite",
    "rules": "node scripts/generate-rules.mjs",
    "rules:check": "node scripts/generate-rules.mjs && git diff --exit-code -- src/generated",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.3",
    "mustache": "^4.2.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/mustache": "^4.2.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "yaml": "^2.9.0"
  }
}
