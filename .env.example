# Copy to `.env` and adjust. NEVER commit a real `.env`. These are development placeholders only.

# --- Database (used by both the app and the MySQL container) ---
MYSQL_DATABASE=restart
MYSQL_USER=restart
MYSQL_PASSWORD=restart
MYSQL_ROOT_PASSWORD=root

# --- Application datasource (when running the jar directly, not via compose) ---
DB_URL=jdbc:mysql://localhost:3306/restart?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=restart
DB_PASSWORD=restart

# --- JWT secrets: generate strong random values for anything real ---
JWT_ACCESS_SECRET=local-development-access-secret-change-me-01234567890
JWT_REFRESH_SECRET=local-development-refresh-secret-change-me-01234567890

# --- CORS (frontend dev origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Active Spring profile ---
SPRING_PROFILES_ACTIVE=local

# --- Host port mappings (override to avoid clashes) ---
MYSQL_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=3000
ADMINER_PORT=8081
